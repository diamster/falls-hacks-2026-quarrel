{
  "name": "quarrel-io",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run test:coverage && npm run build",
    "supabase:start": "supabase start -x studio,imgproxy,mailpit,storage-api,edge-runtime,logflare,vector,supavisor",
    "supabase:stop": "supabase stop",
    "supabase:env": "node scripts/local-env.mjs",
    "judge:setup": "node scripts/judge-config.mjs",
    "test:db": "supabase test db",
    "test:supabase": "node --env-file-if-exists=.env.local tests/db/supabase.integration.mjs",
    "test:api": "node --env-file-if-exists=.env.local tests/db/api.integration.mjs",
    "test:leave": "node --env-file-if-exists=.env.local tests/db/leave.integration.mjs",
    "test:debate": "node --env-file-if-exists=.env.local tests/db/debate.integration.mjs",
    "test:judge": "node --env-file-if-exists=.env.local tests/db/judge.integration.mjs",
    "test:judge:live": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/judge-live.test.ts",
    "test:lawyer": "node --env-file-if-exists=.env.local tests/db/lawyer.integration.mjs",
    "test:stage6a": "node --env-file-if-exists=.env.local tests/db/stage6a.integration.mjs",
    "test:stage6b": "node --env-file-if-exists=.env.local tests/db/stage6b.integration.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^29.1.1",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
