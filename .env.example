# Copy to ignored .env.local. Never commit runtime credentials.
# Supabase uses only the publishable key plus verified player sessions.
# Do not configure a Supabase secret/service-role key.
SUPABASE_URL=https://exjdvtqsalnkghyohyuh.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-project-publishable-key

# Optional Gemini key; blank means deterministic demo mode for new debates.
# These values are server-only. Do not add NEXT_PUBLIC_ prefixes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional one-model failover on quota/provider outages; same total timeout.
GEMINI_FALLBACK_MODEL=
JUDGE_AI_MODE=auto
JUDGE_AI_TIMEOUT_MS=8000
JUDGE_MAX_MESSAGES_PER_TURN=2

# Optional speech credential, independent of GEMINI_API_KEY above.
# Only saved public messages are eligible. Blank/unavailable keeps text working.
# Never set a NEXT_PUBLIC_ prefix or substitute the text-generation key.
GEMINI_TTS_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_TIMEOUT_MS=20000

# Run npm run judge:setup to generate this capability and its hash-only SQL.
# Review/apply the SQL to the intended Cloud project after the Stage 4 migrations.
# Keep the same secret on every app instance using that project's registered hash.
# Setup SQL refuses to replace a different already-registered capability.
JUDGE_SERVER_SECRET=
